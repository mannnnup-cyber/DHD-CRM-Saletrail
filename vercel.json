{
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm install",
  "devCommand": "npm run dev",
  "functions": {
    "api/email.ts": {
      "maxDuration": 60
    },
    "api/whatsapp.ts": {
      "maxDuration": 60
    },
    "api/recordings.ts": {
      "maxDuration": 120
    },
    "api/transcribe.ts": {
      "maxDuration": 300
    },
    "api/analyze.ts": {
      "maxDuration": 120
    }
  },
  "crons": [
    {
      "path": "/api/transcribe",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/analyze?action=batchAnalyze",
      "schedule": "30 * * * *"
    }
  ]
}
